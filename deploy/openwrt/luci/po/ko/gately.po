msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ko\n"

msgid "Admin interface"
msgstr "관리 화면"

msgid "Admin port"
msgstr "관리 화면 포트"

msgid "Configuration directory"
msgstr "설정 디렉터리"

msgid "Default account admin / gately.cn. If you forget the password, run gately reset-password on the router."
msgstr "기본 계정은 admin / gately.cn 입니다. 비밀번호를 잊었다면 라우터에서 gately reset-password 를 실행하세요."

msgid "Disable start on boot"
msgstr "부팅 시 자동 시작 끄기"

msgid "Disabled"
msgstr "꺼짐"

msgid "Enable start on boot"
msgstr "부팅 시 자동 시작 켜기"

msgid "Enabled"
msgstr "켜짐"

msgid "Failed to run the action: %s"
msgstr "작업 실패: %s"

msgid "Gately is an open-source network gateway: port forwarding, reverse proxy, DDNS, ACME certificates, WAF and more. Manage the service here and open the Gately admin interface for everything else."
msgstr "Gately 는 오픈 소스 네트워크 게이트웨이입니다: 포트 포워딩, 리버스 프록시, DDNS, ACME 인증서, WAF 등. 여기서 서비스를 관리하고, 그 밖의 기능은 Gately 관리 화면에서 사용하세요."

msgid "Gately is not installed. Install the gately package first."
msgstr "Gately 가 설치되어 있지 않습니다. 먼저 gately 패키지를 설치하세요."

msgid "LAN only is on in the Gately global settings, so only LAN addresses can open it"
msgstr "Gately 전역 설정에서 '내부망 전용'이 켜져 있어 내부망 주소에서만 열 수 있습니다"

msgid "Leave empty to use the listen address in the Gately global settings (currently %s). When set, Gately listens on this port on all addresses, and listen address changes made in Gately take effect only after this field is cleared."
msgstr "비워 두면 Gately 전역 설정의 수신 주소(현재 %s)를 사용합니다. 입력하면 Gately 는 모든 주소에서 이 포트로 수신하며, Gately 에서 바꾼 수신 주소는 이 항목을 비운 뒤에 적용됩니다."

msgid "Memory"
msgstr "메모리"

msgid "Not running"
msgstr "실행 중 아님"

msgid "Only reachable from the router itself (listening on %s)"
msgstr "라우터 자체에서만 접속할 수 있습니다(수신 %s)"

msgid "Open admin interface"
msgstr "관리 화면 열기"

msgid "Restart"
msgstr "재시작"

msgid "Running (PID %d)"
msgstr "실행 중 (PID %d)"

msgid "Running state"
msgstr "실행 상태"

msgid "Settings"
msgstr "설정"

msgid "Start on boot"
msgstr "부팅 시 자동 시작"

msgid "Start"
msgstr "시작"

msgid "Status"
msgstr "상태"

msgid "Stop"
msgstr "중지"

msgid "Version"
msgstr "버전"
